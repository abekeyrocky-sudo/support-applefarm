# =================================================================
# Apple Farm Support Bot - Standalone Environment Configuration
# =================================================================

# 1. Telegram Bot Token
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Support Admin Telegram ID or Admin Group Chat ID
ADMIN_CHAT_ID=YOUR_TELEGRAM_USER_ID_OR_GROUP_ID
ADMIN_IDS=YOUR_TELEGRAM_USER_ID

# 3. Main Apple Farm App Links (For menu buttons)
MINI_APP_URL=https://t.me/AppleFarmOfficialBot/App
CHANNEL_URL=https://t.me/AppleFarmCommunity
MAIN_BOT_URL=https://t.me/Apple_farm_bot

# 4. Webhook Settings (For Vercel deployment)
WEBHOOK_URL=https://your-support-bot.vercel.app/api/webhook
WEBHOOK_SECRET=your_custom_secret_key_here
